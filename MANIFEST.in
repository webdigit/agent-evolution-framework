include CHANGELOG.md
include COMMERCIAL-LICENSE.md
include CONTRIBUTING.md
include SECURITY.md
recursive-include tests *
recursive-exclude tests __pycache__
global-exclude *.py[cod]
recursive-include docs *.md *.json
prune docs/prompts
recursive-exclude docs/prompts *
prune _bmad
prune _bmad-output
prune .agents
recursive-exclude _bmad *
recursive-exclude _bmad-output *
recursive-exclude .agents *
