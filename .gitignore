# Python environments
.venv/
venv/
env/

# Python caches and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
.pyright/

# Packaging and build artifacts
build/
dist/
# Root-only variants (dist-lot6, dist-prep-2.0.0, ...). Anchored on
# purpose: dist*/ would also ignore distribution/ and distinct/.
/dist-*/
*.egg-info/
*.egg
wheels/
.release-venv/
.artifact-venv/

# Local configuration and secrets
.env
.env.*
!.env.example

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.tmp/
tmp/
temp/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local AEF pilot workspaces and generated agent state
.agent/
pilot-workspace/
pilot-workspace-*/

# Local BMAD Method install and generated artifacts.
# Team customization under _bmad/custom/ is versioned (BMAD canon); personal
# *.user.toml stays ignored. Render, config install outputs, and other _bmad/
# trees remain local-only.
_bmad/*
!_bmad/custom/
!_bmad/custom/**
_bmad/custom/*.user.toml
_bmad-output/
.agents/skills/bmad-*/
